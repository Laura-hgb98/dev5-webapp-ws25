{
	"name": "C# (.NET)",
	"image": "mcr.microsoft.com/devcontainers/dotnet:2-9.0",
	"runArgs": [ // docker run <runArgs
		"--name",
		"deo-devcontainer",
		"--network",
		"deo-network"
	], // docker run --network deo-network
	"postCreateCommand": "dotnet restore --locked-mode && dotnet dev-certs https", //herstellen von nuget packages,
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-dotnettools.csdevkit",
				"humao.rest-client",
				"SonarSource.sonarlint-vscode"
			]
		}
	}
}